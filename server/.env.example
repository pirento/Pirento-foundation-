NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pirento
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Public URL of the site, printed on certificates as the verify link
SITE_URL=https://pirentofoundation.org

# First admin account (created on startup if it does not exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay keys (dashboard.razorpay.com → Settings → API keys). Leave empty to keep online donations off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → URL https://pirentofoundation.org/api/donations/webhook,
# events: payment.captured, payment.failed, subscription.charged, subscription.activated,
# subscription.halted, subscription.cancelled, subscription.completed. Paste the webhook secret here.
# Monthly giving needs Subscriptions enabled on your Razorpay account.
RAZORPAY_WEBHOOK_SECRET=

# Google sign-in: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web).
# Add your site URL under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Email OTP via SMTP (Gmail app password, Zoho, Amazon SES, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pirento Foundation <support@pirentofoundation.org>"
# Inbox that receives contact-form messages
SUPPORT_EMAIL=support@pirentofoundation.org

# Mobile OTP via MSG91 (recommended for India: create an OTP template with ##OTP## and register it on DLT)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# ...or via Twilio (Indian numbers need a DLT-registered sender/template)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Local testing only: with DEV_SHOW_CODES=1 (and NODE_ENV not production) and no SMTP/Twilio,
# codes are printed in the server log and shown on screen. Never set this on a live server.
DEV_SHOW_CODES=

# Bharat ID by Pirento (OpenID Connect). Register this site as a client on Bharat ID with
# redirect URI https://pirentofoundation.org/api/auth/bharatid/callback. Leave empty to hide the button.
BHARATID_ISSUER=
BHARATID_CLIENT_ID=
BHARATID_CLIENT_SECRET=
