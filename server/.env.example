PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pirento
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Public URL of the site, printed on certificates as the verify link
SITE_URL=http://localhost:5173

# First admin account (created on startup if it does not exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay keys (dashboard.razorpay.com → Settings → API keys). Leave empty to keep online donations off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google sign-in: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web).
# Add your site URL under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Email OTP via SMTP (Gmail app password, Zoho, Amazon SES, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pirento Foundation <no-reply@your-domain>"

# Mobile OTP via Twilio (Indian numbers need a DLT-registered sender/template)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Without SMTP/Twilio and outside production, codes are printed in the server log and shown on screen for testing.
